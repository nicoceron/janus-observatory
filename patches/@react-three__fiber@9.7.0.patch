+// Timer-backed compatibility for the public R3F clock API. No document listeners.
+class FrameClock {
+  constructor() {
+    this.timer = new THREE.Timer();
+    this.autoStart = true;
+    this.startTime = 0;
+    this.oldTime = 0;
+    this.elapsedTime = 0;
+    this.running = false;
+  }
+  start() {
+    this.startTime = performance.now();
+    this.oldTime = this.startTime;
+    this.elapsedTime = 0;
+    this.running = true;
+    this.timer.reset();
+  }
+  stop() {
+    this.getDelta();
+    this.running = false;
+    this.autoStart = false;
+  }
+  getDelta() {
+    if (this.autoStart && !this.running) {
+      this.start();
+      return 0;
+    }
+    if (!this.running) return 0;
+    this.timer.update();
+    const delta = this.timer.getDelta();
+    this.oldTime += delta * 1000;
+    this.elapsedTime += delta;
+    return delta;
+  }
+  getElapsedTime() {
+    // Frame subscribers read the same simulation time without advancing it again.
+    return this.elapsedTime;
+  }
+}
