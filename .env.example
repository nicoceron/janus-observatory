# Server-only. Never expose this value through NEXT_PUBLIC_* or commit a real key.
DEEPSEEK_API_KEY=
JANUS_LLM_BASE_URL=https://api.deepseek.com
JANUS_LLM_MODEL=deepseek-v4-flash
JANUS_LLM_PROTOCOL=responses
JANUS_LLM_TIMEOUT_MS=30000
JANUS_LLM_MAX_TOOL_ROUNDS=6
JANUS_LLM_MAX_OUTPUT_TOKENS=800
JANUS_AGENT_LIVE_ENABLED=false
JANUS_RESEARCH_PREVIEW_ENABLED=false
JANUS_RESEARCH_HYBRID_ENABLED=false
JANUS_RESEARCH_VECTOR_CANDIDATES=30
JANUS_RESEARCH_MAX_QUESTION_CHARS=600
JANUS_RESEARCH_MAX_PASSAGES=8
JANUS_RESEARCH_TIMEOUT_MS=30000
JANUS_RESEARCH_RATE_LIMIT=6
JANUS_RESEARCH_RATE_WINDOW_MS=60000
JANUS_RESEARCH_MAX_CONCURRENCY=4
JANUS_RATE_LIMIT_SALT=replace-with-a-deployment-secret
# Never set either standard forwarding header here. Use a dedicated header that the edge strips,
# overwrites with one validated client IP, and authenticates on the backend hop.
JANUS_RESEARCH_TRUSTED_IP_HEADER=
JANUS_RESEARCH_PROXY_SECRET=

# Public absolute origin used for canonical metadata, sitemap, and crawler files.
# Example: https://observatory.example.org (no trailing path).
JANUS_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_JANUS_TELEMETRY_ENABLED=false
JANUS_TELEMETRY_HASH_SALT=replace-with-a-deployment-secret
# Only trust a proxy-provided IP after the edge strips incoming copies and adds both headers.
JANUS_TELEMETRY_TRUSTED_IP_HEADER=
JANUS_TELEMETRY_PROXY_SECRET=
# Enable only on a final HTTPS origin after every included subdomain is HTTPS-ready.
JANUS_ENABLE_HSTS=false
# Upgrade subresources only on a deployment that already serves the application over HTTPS.
# Leave false for local HTTP and preview origins without valid HTTPS.
JANUS_ENABLE_HTTPS_UPGRADE=false

# Selected production embedding service. The app must also support keyword-only
# retrieval when this is absent.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_EMBEDDING_DIMENSIONS=1024
VOYAGE_TIMEOUT_MS=30000

# Optional persistence. Local development starts without these services.
DATABASE_URL=
REDIS_URL=
