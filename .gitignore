# JavaScript
node_modules/
.pnpm-store/
.next/
out/
coverage/
*.tsbuildinfo

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# Secrets
.env
.env.*
!.env.example

# Downloaded source documents and restricted intake
data/sources/files/
incoming/**
!incoming/README.md
!incoming/**/
!incoming/**/.gitkeep

# Local/editor output
.DS_Store
.idea/
.vscode/
playwright-report/
test-results/
tmp/

# Licensed Fab source packages are controlled local inputs, not distributable repo assets.
assets/sources/fab/*.zip
assets/sources/fab/*.blend
assets/sources/fab/*.blend1
assets/sources/fab/extracted/
assets/sources/generated/scenarios/*.png
docs/qa/fab-source-inspection/
docs/qa/janus-fab-observer-v2/frame-*.png

# Repo-local Codex home (auth.json, sessions, logs) - separate account for this repo
.codex/

# Recoverable Blender autosave and intermediate review frames stay local.
assets/sources/janus-cinematic/*.blend1
media/cinematic-review/public/review/
docs/qa/cinematic-rebuild/browser/
docs/qa/cinematic-rebuild/debug-*.png
docs/qa/cinematic-rebuild/observer/motion/
assets/blender/*.blend1

# Playwright runtime traces are temporary browser output, not source.
docs/qa/**/test-artifacts/
docs/qa/**/*-artifacts/
# Generated captures stay local; reports and reproducible capture scripts are versioned.
docs/qa/**/*.png
docs/qa/**/*.jpg
docs/qa/**/*.webp
docs/qa/**/*.webm
docs/qa/**/*.mp4
docs/qa/**/*.zip
docs/qa/**/*.log

# Cloudflare build products and local authentication/runtime state.
.open-next/
.wrangler/
.dev.vars*
